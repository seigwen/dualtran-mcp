{
  "name": "dualtran-mcp",
  "version": "0.1.0",
  "description": "MCP server: translate text with Google or your own AI model (BYOK, 20+ providers) from any MCP client.",
  "type": "module",
  "bin": { "dualtran-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "mcpName": "io.github.seigwen/dualtran-mcp",
  "files": ["dist", "README.md", "LICENSE", "PRIVACY.md"],
  "keywords": ["mcp", "translation", "translate", "ai", "model-context-protocol"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/azure": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/deepinfra": "^2.0.54",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/xai": "^3.0.93",
    "@modelcontextprotocol/server": "^2.3.1",
    "ai": "^6.0.199",
    "common-tags": "^1.8.2",
    "dualtran": "file:vendor/dualtran-core.tgz",
    "eventsource-parser": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0",
    "vitest": "^0.34.6"
  }
